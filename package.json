{
  "name": "entrenador-leyenda",
  "version": "3.1.0",
  "private": true,
  "description": "Entrenador Leyenda - simulador de carrera de director técnico de fútbol (25 temporadas).",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --watch",
    "test:e2e": "node tests/e2e/regression.mjs",
    "test:e2e:full": "node tests/e2e/regression.mjs --full",
    "test:e2e:golden": "node tests/e2e/regression.mjs --update-golden",
    "validate:ci": "node scripts/validate_ci_local.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "typescript": "^7.0.2"
  }
}
